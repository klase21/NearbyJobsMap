{
  "name": "nearby-jobs-map",
  "version": "0.1.1",
  "private": true,
  "description": "Local-first Korean job collection, comparison, list, map, and application workspace.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/klase21/NearbyJobsMap.git"
  },
  "bugs": {
    "url": "https://github.com/klase21/NearbyJobsMap/issues"
  },
  "homepage": "https://github.com/klase21/NearbyJobsMap#readme",
  "keywords": ["jobs", "map", "sqlite", "nextjs", "local-first"],
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:import:fixtures": "tsx scripts/db-import-fixtures.ts",
    "db:seed:demo": "tsx scripts/db-seed-demo.ts",
    "db:status": "tsx scripts/db-status.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "backup:create": "tsx scripts/backup-create.ts",
    "backup:list": "tsx scripts/backup-list.ts",
    "backup:verify": "tsx scripts/backup-verify.ts",
    "backup:restore": "tsx scripts/backup-restore.ts",
    "db:init": "tsx scripts/db-migrate.ts",
    "db:reset:demo": "tsx scripts/db-reset-demo.ts",
    "release:audit": "tsx scripts/release-audit.ts",
    "docs:screenshots": "tsx scripts/capture-docs-screenshots.ts",
    "docs:screenshots:audit": "tsx scripts/docs/audit-docs-screenshots.ts",
    "release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-check.ps1",
    "windows:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "windows:install-browser": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-browser.ps1",
    "windows:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1",
    "windows:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "windows:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/status.ps1",
    "windows:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "windows:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update.ps1",
    "windows:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "windows:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restore.ps1",
    "windows:support-bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/support-bundle.ps1",
    "support:audit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/support-bundle-audit.ps1",
    "package:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "setup:local": "tsx scripts/setup-local.ts",
    "transport:jobkorea:once": "tsx scripts/jobkorea-one-shot.ts",
    "transport:jobkorea:search:once": "tsx scripts/jobkorea-search-one-shot.ts",
    "collect:jobkorea:once": "tsx scripts/jobkorea-collect-once.ts",
    "backfill:jobkorea:once": "tsx scripts/jobkorea-backfill-once.ts",
    "audit:jobkorea-quality": "tsx scripts/jobkorea-quality-audit.ts",
    "collect:albamon:once": "tsx scripts/albamon-collect-once.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "leaflet": "^1.9.4",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1"
  }
}
