# Local runtime database. Relative paths are resolved from the project root.
NEARBY_JOBS_DB_PATH=./data/nearby-jobs.sqlite

# Collection execution remains disabled unless explicitly enabled locally.
NEARBY_JOBS_ENABLE_COLLECTION_UI=0

# Windows launcher defaults. These are not secrets.
HOSTNAME=127.0.0.1
PORT=3000

# Optional project-local backup directory.
NEARBY_JOBS_BACKUP_DIR=./data/backups
